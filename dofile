* Tabelle 2
use "${holdendata}holden2016.dta",clear

*Datenretsriktionen nach Tablenotes
drop if stype != "E"

*Generierung einer Variable die score aus vorjahr abbildet
bysort cds (year): gen preaveragescore_std = averagescore_std[_n-1]

*Datenretsriktionen
keep if inlist(year, 2002, 2003, 2004)
keep if inrange(api_rel, -19.099, 19.099)

*Generierung Bonus für Schulen unter Treshhold
gen bonus = 0
replace bonus = 1 if api_rel <= 0

*Generierung des Interaktionsterms
gen api_rel_treat = bonus * api_rel

*Predicted Values für average score
reg averagescore_std total pct_wh pct_hi pct_frl
predict a_h1

reg averagescore_std total pct_wh pct_hi pct_frl fte_a fte_p fte_t yrs_dist yrs_teach
predict a_h2

reg averagescore_std total pct_wh pct_hi pct_frl fte_a fte_p fte_t yrs_dist yrs_teach preaveragescore_std
predict a_h3

*Predicted Values für math score
reg mathscore_std total pct_wh pct_hi pct_frl
predict m_h1

reg mathscore_std total pct_wh pct_hi pct_frl fte_a fte_p fte_t yrs_dist yrs_teach
predict m_h2

reg mathscore_std total pct_wh pct_hi pct_frl fte_a fte_p fte_t yrs_dist yrs_teach preaveragescore_std
predict m_h3

*Predicted Values für reading score
reg readingscore_std total pct_wh pct_hi pct_frl
predict r_h1

reg readingscore_std total pct_wh pct_hi pct_frl fte_a fte_p fte_t yrs_dist yrs_teach
predict r_h2

reg readingscore_std total pct_wh pct_hi pct_frl fte_a fte_p fte_t yrs_dist yrs_teach preaveragescore_std
predict r_h3

